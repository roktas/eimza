#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

abort() {
	local message=$1
	local status=${2:-1}

	warn "E: $message"
	exit "$status"
}

card() {
	local config=$1
	local input=$2
	local output=$3
	local akis=$4
	local cert_label=$5
	local token_label=$6

	local probe

	probe=$(pyhanko --config "$config" sign addsig \
		--existing-only \
		--field __imzala_card_probe__ \
		pkcs11 \
		--lib "$akis" \
		--token-label "$token_label" \
		--cert-label "$cert_label" \
		--skip-user-pin \
		"$input" \
		"$output" 2>&1) || :

	case $probe in
	*'No token matching criteria'*)
		abort 'AKIS card or token was not found; insert the card and check the reader.' 3
		;;
	*'__imzala_card_probe__'*'does not exist'*)
		;;
	*)
		printf '%s\n' "$probe" >&2
		abort 'AKIS card check failed.' 3
		;;
	esac
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	printf 'Usage: %s INPUT.pdf [OUTPUT.pdf]\n' "${0##*/}" >&2
	printf '%s\n' 'If OUTPUT.pdf is omitted, INPUT-signed.pdf is created next to INPUT.pdf.' >&2
	exit 2
}

main() {
	[[ $# -ge 1 && $# -le 2 ]] || usage

	(
		local akis cert_label config input output script_dir setup tmp_output tmpdir token_label

		if ! script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P); then
			abort 'Could not determine the script directory.' 3
		fi

		case ${OSTYPE:-} in
		darwin*)
			# TODO: Add the macOS AKIS PKCS#11 module path and pyHanko setup.
			abort 'macOS support is TODO.' 3
			;;
		linux*)
			akis=/usr/lib/libakisp11.so
			cert_label=10391976242NES0
			setup='akis-linux'
			token_label=AKIS_04655182A91F9094
			;;
		*)
			abort "Unsupported operating system: ${OSTYPE:-unknown}." 3
			;;
		esac

		config="$script_dir/pyhanko.yml"

		if ! command -v pyhanko &>/dev/null; then
			abort 'pyhanko was not found in PATH.' 3
		fi

		[[ -f $akis ]] ||
			abort "AKIS PKCS#11 module was not found: $akis" 3
		[[ -f $config ]] ||
			abort "pyhanko.yml was not found next to ${0##*/}." 3

		if ! command -v realpath &>/dev/null; then
			abort 'realpath was not found in PATH.' 3
		fi

		if ! input=$(realpath -- "$1" 2>/dev/null); then
			abort "Input file not found: $1" 2
		fi
		[[ -f $input ]] || abort "Input file not found: $1" 2
		[[ ${input,,} == *.pdf ]] || abort 'Input file must have a .pdf extension.' 2

		if [[ $# -eq 2 ]]; then
			output=$(realpath -m -- "$2") || abort "Invalid output path: $2" 2
			[[ ${output,,} == *.pdf ]] || output+=.pdf
		else
			output="${input%.*}-signed.pdf"
		fi

		[[ $input != "$output" ]] ||
			abort 'Input and output files must be different.' 2
		[[ ! -e $output && ! -L $output ]] ||
			abort "Output file already exists: $output" 2

		cd -- "$script_dir" || abort "Could not enter the script directory: $script_dir" 3

		tmpdir=$(mktemp -d -- "${output}.imzala-tmp-XXXXXX") ||
			abort "Could not create a temporary directory for: $output" 3
		tmp_output="$tmpdir/output.pdf"
		trap 'status=$?; rm -rf -- "$tmpdir" || :; exit "$status"' EXIT
		trap 'exit 129' HUP
		trap 'exit 130' INT
		trap 'exit 131' QUIT
		trap 'exit 143' TERM

		card "$config" "$input" "$tmpdir/card-probe.pdf" "$akis" "$cert_label" "$token_label"

		printf '%s\n' 'Signing:' "  $input" 'Output:' "  $output" ''

		pyhanko --config "$config" sign addsig \
			--field Sig1 \
			--use-pades \
			--timestamp-url http://timestamp.digicert.com \
			pkcs11 \
			--p11-setup "$setup" \
			"$input" \
			"$tmp_output"

		printf '%s\n\n' '' 'Validating signed PDF...'

		pyhanko --config "$config" sign validate \
			--validation-context kamusm \
			--pretty-print \
			"$tmp_output"

		if ! mv -n -- "$tmp_output" "$output"; then
			abort "The validated file could not be moved to: $output" 3
		fi
		[[ ! -e $tmp_output ]] ||
			abort "Output file appeared before it could be created: $output" 2

		printf '\n%s\n%s\n' 'SUCCESS: Signature and timestamp validated.' "  $output"
	)
}

main "$@"
